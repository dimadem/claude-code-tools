{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bun ${CLAUDE_PLUGIN_ROOT}/scripts/trace.ts" }
        ]
      }
    ],
    "SessionEnd": [
